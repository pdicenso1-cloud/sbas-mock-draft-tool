# Copy this file to .streamlit/secrets.toml for local development only.
# Never commit the real secrets.toml file.
#
# On Streamlit Community Cloud, secrets are set through the dashboard's
# Manage app -> Settings -> Secrets panel instead of this file - the app
# reads them via st.secrets the same way either way.

# Optional. Without it, live ADP still works (Fantasy Football Calculator
# needs no key); only FantasyPros consensus rankings/tiers and stat
# projections are skipped until this is set. Get a free key at
# https://www.fantasypros.com/api-data/ (see fantasysync/rankings_sources.py).
# FANTASYPROS_API_KEY = "your-key"

# Future examples:
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_KEY = "your-key"
